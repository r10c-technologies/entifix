{
  "name": "@entifix/example-minimal-domain",
  "version": "0.0.0",
  "private": true,
  "description": "The one entity example-minimal serves and edits, compiled by SWC with 2022-03 decorators.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@entifix/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": true,
  "nx": {
    "sourceRoot": "examples/minimal-domain/src",
    "targets": {
      "build": {
        "executor": "@nx/js:swc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "examples/minimal-domain/dist",
          "main": "examples/minimal-domain/src/index.ts",
          "tsConfig": "examples/minimal-domain/tsconfig.lib.json",
          "skipTypeCheck": true,
          "stripLeadingPaths": true
        }
      }
    }
  },
  "dependencies": {
    "@entifix/core": "workspace:*",
    "@swc/helpers": "0.5.23"
  }
}
