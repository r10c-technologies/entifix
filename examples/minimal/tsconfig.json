{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "noEmit": true,
    "emitDeclarationOnly": false,
    "composite": false,
    "declarationMap": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "lib": ["dom", "dom.iterable", "esnext", "decorators", "esnext.decorators"],
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "types": ["node"],
    "outDir": "dist",
    "rootDir": ".",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo"
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["out-tsc", "dist", "node_modules", ".next", "eslint.config.mjs"],
  "references": [
    {
      "path": "../../packages/ts/testing-auth"
    },
    {
      "path": "../../packages/ts/rest-client"
    },
    {
      "path": "../../packages/react/integration"
    },
    {
      "path": "../../packages/react/controls"
    },
    {
      "path": "../../packages/next/shell"
    },
    {
      "path": "../../packages/next/i18n"
    },
    {
      "path": "../../packages/ts/i18n"
    },
    {
      "path": "../minimal-domain"
    },
    {
      "path": "../../packages/ts/core"
    },
    {
      "path": "../../packages/ts/business"
    }
  ]
}
