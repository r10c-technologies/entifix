{
  "name": "@entifix/example-docs",
  "version": "0.0.0",
  "private": true,
  "description": "entifix's documentation instance on @entifix/docs-engine: its decision records, a page per published package and the controls' Storybook under one origin (/docs and /ui), exported as static files, searched with Pagefind and served by one dependency-free script.",
  "dependencies": {
    "@entifix/core": "workspace:*",
    "@entifix/docs": "workspace:*",
    "@entifix/docs-engine": "workspace:*",
    "@entifix/i18n": "workspace:*",
    "@entifix/react-controls": "workspace:*",
    "@entifix/style": "workspace:*",
    "fumadocs-ui": "16.19.6",
    "i18next": "27.2.3",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "18.0.3"
  },
  "devDependencies": {
    "pagefind": "1.6.0"
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "^build",
          "@entifix/react-controls:build-storybook"
        ],
        "inputs": [
          "production",
          "^production",
          "{workspaceRoot}/packages/**/package.json"
        ],
        "outputs": [
          "{projectRoot}/out",
          "{projectRoot}/ui"
        ],
        "options": {
          "command": "next build && pagefind --site out --output-subdir pagefind && rm -rf ui && cp -R ../../packages/react/controls/storybook-static ui",
          "cwd": "examples/docs",
          "forwardAllArgs": false
        }
      },
      "serve-static": {
        "executor": "nx:run-commands",
        "continuous": true,
        "options": {
          "command": "node serve.mjs",
          "cwd": "examples/docs"
        }
      },
      "container": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build"
        ],
        "options": {
          "command": "docker build -t entifix/docs:local examples/docs",
          "forwardAllArgs": false
        }
      }
    }
  }
}
