{
  "name": "@entifix/example-minimal-e2e",
  "version": "0.0.0",
  "private": true,
  "nx": {
    "implicitDependencies": [
      "@entifix/example-minimal",
      "@entifix/example-minimal-service"
    ],
    "targets": {
      "e2e-live": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "@entifix/example-minimal:build",
          {
            "projects": [
              "@entifix/example-minimal-service"
            ],
            "target": "build",
            "params": "ignore"
          },
          "^build"
        ],
        "options": {
          "command": "playwright test --config playwright.live.config.ts",
          "cwd": "examples/minimal-e2e"
        }
      }
    }
  },
  "devDependencies": {
    "@nx/devkit": "23.0.1",
    "@playwright/test": "1.61.1"
  }
}
