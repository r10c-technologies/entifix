# Provenance is an OIDC attestation signed by the workflow run that published
# the tarball, and it is what makes `@entifix/*` coming out of an org named
# `r10c-technologies` legible to a stranger rather than typosquat-shaped. It
# cannot be added to a version after the fact.
#
# It is set here rather than as `NPM_CONFIG_PROVENANCE` in the workflow because
# `provenance` is one of `pnpm publish`'s rc options — read from this file, not
# from the environment. Left unset, pnpm derives it instead by asking the
# registry whether the package is public, which 404s for a package that does not
# exist yet: the very first publish of every package would silently ship with no
# attestation and a `Skipped setting provenance` warning.
#
# Outside CI this makes `pnpm publish` fail rather than publish unattested. A
# local rehearsal against verdaccio passes `--no-provenance`.
provenance=true
