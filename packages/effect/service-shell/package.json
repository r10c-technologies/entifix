{
  "name": "@entifix/service-shell",
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/r10c-technologies/entifix.git",
    "directory": "packages/effect/service-shell"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@entifix/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "nx": {
    "tags": [
      "layer:shell",
      "scope:shared",
      "shell:base",
      "tier:4"
    ],
    "sourceRoot": "packages/effect/service-shell/src",
    "targets": {
      "build": {
        "executor": "@nx/js:swc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "packages/effect/service-shell/dist",
          "main": "packages/effect/service-shell/src/index.ts",
          "tsConfig": "packages/effect/service-shell/tsconfig.lib.json",
          "skipTypeCheck": true,
          "stripLeadingPaths": true
        }
      }
    }
  },
  "dependencies": {
    "@effect/opentelemetry": "0.64.0",
    "@effect/platform": "0.97.1",
    "@effect/platform-node": "0.108.1",
    "@opentelemetry/context-async-hooks": "2.10.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.221.0",
    "@opentelemetry/sdk-metrics": "2.10.0",
    "@opentelemetry/sdk-trace-base": "2.10.0",
    "@entifix/authz": "workspace:*",
    "@entifix/business": "workspace:*",
    "@entifix/core": "workspace:*",
    "@entifix/tooling": "workspace:*",
    "@swc/helpers": "0.5.23"
  },
  "devDependencies": {
    "@opentelemetry/api": "1.9.1",
    "@entifix/testing-unit": "workspace:*",
    "effect": "3.22.1"
  },
  "peerDependencies": {
    "@opentelemetry/api": ">=1.9 <2",
    "effect": ">=3.22 <4"
  }
}
