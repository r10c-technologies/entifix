{
  "name": "@entifix/service-shell",
  "version": "0.4.3",
  "description": "Effect HTTP service skeleton: server layer, health and metadata routes, permission guards, remote configuration and OpenTelemetry.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/r10c-technologies/entifix.git",
    "directory": "packages/effect/service-shell"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@entifix/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "@entifix/source": "./src/runtime.ts",
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js",
      "default": "./dist/runtime.js"
    },
    "./observability": {
      "@entifix/source": "./src/observability.ts",
      "types": "./dist/observability.d.ts",
      "import": "./dist/observability.js",
      "default": "./dist/observability.js"
    },
    "./testing": {
      "@entifix/source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    }
  },
  "nx": {
    "tags": [
      "tier:4"
    ],
    "sourceRoot": "packages/effect/service-shell/src",
    "targets": {
      "build": {
        "executor": "@nx/js:swc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "packages/effect/service-shell/dist",
          "main": "packages/effect/service-shell/src/index.ts",
          "tsConfig": "packages/effect/service-shell/tsconfig.lib.json",
          "skipTypeCheck": true,
          "stripLeadingPaths": true
        }
      }
    }
  },
  "dependencies": {
    "@entifix/authz": "workspace:*",
    "@entifix/business": "workspace:*",
    "@entifix/core": "workspace:*",
    "@entifix/tooling": "workspace:*",
    "@swc/helpers": "0.5.23"
  },
  "devDependencies": {
    "@effect/opentelemetry": "4.0.5",
    "@effect/platform-node": "4.0.5",
    "@entifix/testing-unit": "workspace:*",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/context-async-hooks": "2.12.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "effect": "4.0.5"
  },
  "peerDependencies": {
    "@effect/opentelemetry": "^4.0.5",
    "@effect/platform-node": "^4.0.5",
    "@opentelemetry/api": ">=1.9 <2",
    "@opentelemetry/context-async-hooks": ">=2.12 <3",
    "@opentelemetry/exporter-metrics-otlp-http": ">=0.223 <0.224",
    "@opentelemetry/exporter-trace-otlp-http": ">=0.223 <0.224",
    "@opentelemetry/sdk-metrics": ">=2.12 <3",
    "@opentelemetry/sdk-trace-base": ">=2.12 <3",
    "effect": "^4.0.5"
  },
  "peerDependenciesMeta": {
    "@effect/opentelemetry": {
      "optional": true
    },
    "@effect/platform-node": {
      "optional": true
    },
    "@opentelemetry/api": {
      "optional": true
    },
    "@opentelemetry/context-async-hooks": {
      "optional": true
    },
    "@opentelemetry/exporter-metrics-otlp-http": {
      "optional": true
    },
    "@opentelemetry/exporter-trace-otlp-http": {
      "optional": true
    },
    "@opentelemetry/sdk-metrics": {
      "optional": true
    },
    "@opentelemetry/sdk-trace-base": {
      "optional": true
    }
  }
}
