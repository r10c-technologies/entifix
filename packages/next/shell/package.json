{
  "name": "@entifix/next-shell",
  "nx": {
    "tags": [
      "layer:shell",
      "scope:shared",
      "shell:base",
      "tier:4"
    ],
    "sourceRoot": "packages/next/shell/src",
    "targets": {
      "build": {
        "executor": "@nx/js:swc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "packages/next/shell/dist",
          "main": "packages/next/shell/src/index.ts",
          "tsConfig": "packages/next/shell/tsconfig.lib.json",
          "skipTypeCheck": true,
          "stripLeadingPaths": true
        }
      }
    }
  },
  "version": "0.1.1",
  "description": "Next.js application shell: back-office chrome, workspace tabs, CRUD screens derived from entity metadata, and session and proxy routes.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/r10c-technologies/entifix.git",
    "directory": "packages/next/shell"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@entifix/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "@entifix/source": "./src/server.ts",
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    }
  },
  "devDependencies": {
    "@entifix/testing-unit": "workspace:*",
    "@tanstack/react-query": "^5.101.4",
    "effect": "3.22.1",
    "i18next": "26.3.6",
    "next": "16.2.10",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "^5.0.15"
  },
  "dependencies": {
    "@entifix/authz": "workspace:*",
    "@entifix/react-controls": "workspace:*",
    "@entifix/react-integration": "workspace:*",
    "@entifix/transactions": "workspace:*",
    "@entifix/business": "workspace:*",
    "@entifix/core": "workspace:*",
    "@entifix/i18n": "workspace:*",
    "idb": "^8.0.3"
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo",
    "LICENSE"
  ],
  "peerDependencies": {
    "@tanstack/react-query": ">=5.101 <6",
    "effect": ">=3.22 <4",
    "i18next": ">=26 <27",
    "next": ">=16 <17",
    "react": ">=19 <20",
    "react-dom": ">=19 <20",
    "zustand": ">=5 <6"
  },
  "peerDependenciesMeta": {
    "i18next": {
      "optional": true
    }
  }
}
