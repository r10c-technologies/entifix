{
  "name": "@entifix/next-i18n",
  "version": "0.10.0",
  "description": "Next.js locale routing and server-side translation for @entifix/i18n, with the locale carried in the URL prefix.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/r10c-technologies/entifix.git",
    "directory": "packages/next/i18n"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@entifix/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "@entifix/source": "./src/server.ts",
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo",
    "LICENSE"
  ],
  "nx": {
    "tags": [
      "tier:4"
    ],
    "sourceRoot": "packages/next/i18n/src",
    "targets": {
      "build": {
        "executor": "@nx/js:swc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "packages/next/i18n/dist",
          "main": "packages/next/i18n/src/index.ts",
          "tsConfig": "packages/next/i18n/tsconfig.lib.json",
          "skipTypeCheck": true,
          "stripLeadingPaths": true
        }
      }
    }
  },
  "dependencies": {
    "@entifix/core": "workspace:*",
    "@entifix/i18n": "workspace:*",
    "@swc/helpers": "0.5.23"
  },
  "peerDependencies": {
    "i18next": ">=26 <27",
    "next": ">=16"
  },
  "devDependencies": {
    "i18next": "26.5.3",
    "next": "16.4.2"
  },
  "peerDependenciesMeta": {
    "i18next": {
      "optional": true
    }
  }
}
