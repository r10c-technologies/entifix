{
  "name": "@entifix/sql",
  "version": "0.11.0",
  "description": "SQL adapter over @effect/sql: an entity repository with RSQL filter and sort translation, and a health probe.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/r10c-technologies/entifix.git",
    "directory": "packages/ts/sql-client"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@entifix/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./transactions": {
      "@entifix/source": "./src/transactions/index.ts",
      "types": "./dist/transactions/index.d.ts",
      "import": "./dist/transactions/index.js",
      "default": "./dist/transactions/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo",
    "LICENSE"
  ],
  "nx": {
    "tags": [
      "tier:2"
    ],
    "sourceRoot": "packages/ts/sql-client/src",
    "targets": {
      "build": {
        "executor": "@nx/js:swc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "packages/ts/sql-client/dist",
          "main": "packages/ts/sql-client/src/index.ts",
          "tsConfig": "packages/ts/sql-client/tsconfig.lib.json",
          "skipTypeCheck": true,
          "stripLeadingPaths": true
        }
      },
      "test-integration": {
        "executor": "nx:run-commands",
        "options": {
          "command": "vitest run --config vitest.integration.mts",
          "cwd": "packages/ts/sql-client"
        }
      }
    }
  },
  "dependencies": {
    "@entifix/business": "workspace:*",
    "@entifix/core": "workspace:*",
    "@swc/helpers": "0.5.23"
  },
  "devDependencies": {
    "@effect/sql-pg": "4.0.6",
    "@entifix/testing-unit": "workspace:*",
    "@entifix/transactions": "workspace:*",
    "effect": "4.0.6"
  },
  "peerDependencies": {
    "effect": "^4.0.6",
    "@entifix/transactions": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@entifix/transactions": {
      "optional": true
    }
  }
}
