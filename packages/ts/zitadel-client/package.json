{
  "name": "@entifix/zitadel",
  "version": "0.1.1",
  "description": "Zitadel client: OIDC sign-in with PKCE, back-channel logout, the management API, and signed Actions webhooks.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/r10c-technologies/entifix.git",
    "directory": "packages/ts/zitadel-client"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@entifix/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo",
    "LICENSE"
  ],
  "nx": {
    "tags": [
      "layer:entifix",
      "scope:shared",
      "entifix:client",
      "runtime:datastore",
      "tier:2"
    ],
    "sourceRoot": "packages/ts/zitadel-client/src",
    "targets": {
      "build": {
        "executor": "@nx/js:swc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "packages/ts/zitadel-client/dist",
          "main": "packages/ts/zitadel-client/src/index.ts",
          "tsConfig": "packages/ts/zitadel-client/tsconfig.lib.json",
          "skipTypeCheck": true,
          "stripLeadingPaths": true
        }
      }
    }
  },
  "dependencies": {
    "@entifix/business": "workspace:*",
    "@entifix/core": "workspace:*",
    "@swc/helpers": "0.5.23",
    "jose": "6.2.8"
  },
  "devDependencies": {
    "@entifix/testing-unit": "workspace:*",
    "effect": "3.22.1"
  },
  "peerDependencies": {
    "effect": ">=3.22 <4"
  }
}
