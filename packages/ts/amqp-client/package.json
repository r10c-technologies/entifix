{
  "name": "@entifix/amqp",
  "version": "0.5.1",
  "description": "RabbitMQ connection and health probe, and an optional event bus for @entifix/transactions with retry and quarantine.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/r10c-technologies/entifix.git",
    "directory": "packages/ts/amqp-client"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@entifix/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./transactions": {
      "@entifix/source": "./src/transactions/index.ts",
      "types": "./dist/transactions/index.d.ts",
      "import": "./dist/transactions/index.js",
      "default": "./dist/transactions/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo",
    "LICENSE"
  ],
  "nx": {
    "tags": [
      "tier:2"
    ],
    "sourceRoot": "packages/ts/amqp-client/src",
    "targets": {
      "build": {
        "executor": "@nx/js:swc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "packages/ts/amqp-client/dist",
          "main": "packages/ts/amqp-client/src/index.ts",
          "tsConfig": "packages/ts/amqp-client/tsconfig.lib.json",
          "skipTypeCheck": true,
          "stripLeadingPaths": true
        }
      }
    }
  },
  "dependencies": {
    "@entifix/business": "workspace:*",
    "@entifix/core": "workspace:*",
    "@swc/helpers": "0.5.23",
    "amqplib": "2.2.0"
  },
  "devDependencies": {
    "@entifix/testing-unit": "workspace:*",
    "@entifix/transactions": "workspace:*",
    "@types/amqplib": "0.10.8",
    "effect": "4.0.5"
  },
  "peerDependencies": {
    "@entifix/transactions": "workspace:*",
    "effect": "^4.0.5"
  },
  "peerDependenciesMeta": {
    "@entifix/transactions": {
      "optional": true
    }
  }
}
