{
  "name": "@entifix/posthog",
  "version": "0.1.2",
  "description": "PostHog adapter for the @entifix/tooling Tracker port, over posthog-node on the server and posthog-js in the browser.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/r10c-technologies/entifix.git",
    "directory": "packages/ts/posthog-client"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@entifix/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./browser": {
      "@entifix/source": "./src/browser/index.ts",
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js",
      "default": "./dist/browser/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo",
    "LICENSE"
  ],
  "nx": {
    "tags": [
      "tier:2"
    ],
    "sourceRoot": "packages/ts/posthog-client/src",
    "targets": {
      "build": {
        "executor": "@nx/js:swc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "packages/ts/posthog-client/dist",
          "main": "packages/ts/posthog-client/src/index.ts",
          "tsConfig": "packages/ts/posthog-client/tsconfig.lib.json",
          "skipTypeCheck": true,
          "stripLeadingPaths": true
        }
      }
    }
  },
  "dependencies": {
    "@entifix/tooling": "workspace:*",
    "@swc/helpers": "0.5.23",
    "posthog-js": "1.417.0",
    "posthog-node": "5.49.0"
  }
}
