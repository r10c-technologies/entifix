{
  "name": "@entifix/business",
  "version": "0.11.0",
  "description": "The ports every adapter implements \u2014 repository, session, token, health \u2014 and the generic get, load, save and delete use-cases.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/r10c-technologies/entifix.git",
    "directory": "packages/ts/business"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@entifix/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./flow": {
      "@entifix/source": "./src/flow/index.ts",
      "types": "./dist/flow/index.d.ts",
      "import": "./dist/flow/index.js",
      "default": "./dist/flow/index.js"
    },
    "./verified": {
      "@entifix/source": "./src/verified/index.ts",
      "types": "./dist/verified/index.d.ts",
      "import": "./dist/verified/index.js",
      "default": "./dist/verified/index.js"
    },
    "./compose": {
      "@entifix/source": "./src/compose/index.ts",
      "types": "./dist/compose/index.d.ts",
      "import": "./dist/compose/index.js",
      "default": "./dist/compose/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo",
    "LICENSE"
  ],
  "nx": {
    "tags": [
      "tier:1"
    ],
    "sourceRoot": "packages/ts/business/src",
    "targets": {
      "build": {
        "executor": "@nx/js:swc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "packages/ts/business/dist",
          "main": "packages/ts/business/src/index.ts",
          "tsConfig": "packages/ts/business/tsconfig.lib.json",
          "skipTypeCheck": true,
          "stripLeadingPaths": true
        }
      }
    }
  },
  "dependencies": {
    "@entifix/core": "workspace:*",
    "@swc/helpers": "0.5.23"
  },
  "peerDependencies": {
    "effect": "^4.0.6"
  },
  "devDependencies": {
    "effect": "4.0.6"
  }
}
