{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": true,
    "module": "preserve",
    "moduleResolution": "bundler",
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "react"],
    "jsx": "react-jsx",
    "lib": ["es2022", "decorators", "esnext.decorators", "dom", "dom.iterable"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "references": [
    {
      "path": "../core/tsconfig.lib.json"
    },
    {
      "path": "../business/tsconfig.lib.json"
    },
    {
      "path": "../transactions/tsconfig.lib.json"
    },
    {
      "path": "../../react/controls/tsconfig.lib.json"
    }
  ],
  "exclude": ["src/**/*.spec.ts", "src/**/*.spec.tsx", "src/**/*.test.ts"]
}
