{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "out-tsc/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": true,
    "module": "preserve",
    "moduleResolution": "bundler",
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "references": [
    {
      "path": "../testing-unit/tsconfig.lib.json"
    },
    {
      "path": "../core/tsconfig.lib.json"
    },
    {
      "path": "../business/tsconfig.lib.json"
    },
    {
      "path": "../redis-client/tsconfig.lib.json"
    },
    {
      "path": "../mongo-client/tsconfig.lib.json"
    },
    {
      "path": "../amqp-client/tsconfig.lib.json"
    }
  ],
  "exclude": ["src/**/*.spec.ts", "src/**/*.spec.tsx", "src/**/*.test.ts"]
}
