{
  "name": "@entifix/mongo",
  "version": "0.1.1",
  "description": "MongoDB adapter: an entity repository, RSQL-to-Mongo query translation, per-tenant databases, and an optional transactional outbox.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/r10c-technologies/entifix.git",
    "directory": "packages/ts/mongo-client"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@entifix/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./transactions": {
      "@entifix/source": "./src/transactions/index.ts",
      "types": "./dist/transactions/index.d.ts",
      "import": "./dist/transactions/index.js",
      "default": "./dist/transactions/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo",
    "LICENSE"
  ],
  "nx": {
    "tags": [
      "tier:2"
    ],
    "sourceRoot": "packages/ts/mongo-client/src",
    "targets": {
      "build": {
        "executor": "@nx/js:swc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "packages/ts/mongo-client/dist",
          "main": "packages/ts/mongo-client/src/index.ts",
          "tsConfig": "packages/ts/mongo-client/tsconfig.lib.json",
          "skipTypeCheck": true,
          "stripLeadingPaths": true
        }
      }
    }
  },
  "dependencies": {
    "@entifix/business": "workspace:*",
    "@entifix/core": "workspace:*",
    "@swc/helpers": "0.5.23",
    "mongodb": "7.5.0"
  },
  "devDependencies": {
    "@entifix/transactions": "workspace:*",
    "@entifix/testing-unit": "workspace:*",
    "effect": "3.22.1"
  },
  "peerDependencies": {
    "@entifix/transactions": "workspace:*",
    "effect": ">=3.22 <4"
  },
  "peerDependenciesMeta": {
    "@entifix/transactions": {
      "optional": true
    }
  }
}
