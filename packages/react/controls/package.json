{
  "name": "@entifix/react-controls",
  "version": "0.1.0",
  "description": "Entity-agnostic React UI — table, form, filters, wizard, command palette — rendered from entity metadata, plus layout primitives.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/r10c-technologies/entifix.git",
    "directory": "packages/react/controls"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@entifix/core": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "idb": "^8.0.3"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@entifix/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./primitives": {
      "@entifix/source": "./src/primitives.ts",
      "types": "./dist/primitives.d.ts",
      "import": "./dist/primitives.js",
      "default": "./dist/primitives.js"
    },
    "./i18next": {
      "@entifix/source": "./src/i18next/index.tsx",
      "types": "./dist/i18next/index.d.ts",
      "import": "./dist/i18next/index.js",
      "default": "./dist/i18next/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo",
    "LICENSE"
  ],
  "devDependencies": {
    "@entifix/style": "workspace:*",
    "@entifix/i18n": "workspace:*",
    "@storybook/addon-docs": "^10.5.3",
    "@storybook/addon-themes": "^10.5.3",
    "@storybook/react-vite": "^10.5.3",
    "effect": "3.22.1",
    "i18next": "26.3.6",
    "react": "19.2.8",
    "react-i18next": "17.0.11",
    "storybook": "^10.5.3"
  },
  "nx": {
    "tags": [
      "layer:entifix",
      "scope:shared",
      "entifix:react",
      "tier:3"
    ],
    "sourceRoot": "packages/react/controls/src",
    "targets": {
      "build": {
        "executor": "@nx/js:swc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "packages/react/controls/dist",
          "main": "packages/react/controls/src/index.ts",
          "tsConfig": "packages/react/controls/tsconfig.lib.json",
          "skipTypeCheck": true,
          "stripLeadingPaths": true
        }
      },
      "storybook": {
        "command": "storybook dev -p 6006 --no-open",
        "options": {
          "cwd": "{projectRoot}"
        }
      },
      "build-storybook": {
        "command": "storybook build",
        "options": {
          "cwd": "{projectRoot}"
        },
        "outputs": [
          "{projectRoot}/storybook-static"
        ]
      }
    }
  },
  "peerDependencies": {
    "@entifix/i18n": "workspace:*",
    "effect": ">=3.22 <4",
    "i18next": ">=26 <27",
    "react": ">=19 <20",
    "react-i18next": ">=17 <18"
  },
  "peerDependenciesMeta": {
    "@entifix/i18n": {
      "optional": true
    },
    "i18next": {
      "optional": true
    },
    "react-i18next": {
      "optional": true
    }
  }
}
