{
  "name": "@entifix/react-controls",
  "version": "0.20.0",
  "description": "Entity-agnostic React UI — table, form, filters, wizard, command palette — rendered from entity metadata, plus layout primitives.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/r10c-technologies/entifix.git",
    "directory": "packages/react/controls"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@entifix/core": "workspace:*",
    "@headlessui/react": "^2.2.10",
    "class-variance-authority": "^0.7.1",
    "idb": "^8.0.4"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@entifix/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./primitives": {
      "@entifix/source": "./src/primitives.ts",
      "types": "./dist/primitives.d.ts",
      "import": "./dist/primitives.js",
      "default": "./dist/primitives.js"
    },
    "./i18next": {
      "@entifix/source": "./src/i18next/index.tsx",
      "types": "./dist/i18next/index.d.ts",
      "import": "./dist/i18next/index.js",
      "default": "./dist/i18next/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo",
    "LICENSE"
  ],
  "devDependencies": {
    "@entifix/i18n": "workspace:*",
    "@entifix/style": "workspace:*",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-themes": "^10.6.5",
    "@storybook/addon-vitest": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "effect": "4.0.7",
    "i18next": "26.7.2",
    "react": "19.3.1",
    "react-i18next": "17.1.13",
    "storybook": "^10.6.5"
  },
  "nx": {
    "tags": [
      "tier:3"
    ],
    "sourceRoot": "packages/react/controls/src",
    "targets": {
      "build": {
        "executor": "@nx/js:swc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "packages/react/controls/dist",
          "main": "packages/react/controls/src/index.ts",
          "tsConfig": "packages/react/controls/tsconfig.lib.json",
          "skipTypeCheck": true,
          "stripLeadingPaths": true
        }
      },
      "storybook": {
        "command": "storybook dev -p 6006 --no-open",
        "options": {
          "cwd": "{projectRoot}"
        }
      },
      "build-storybook": {
        "command": "storybook build",
        "options": {
          "cwd": "{projectRoot}"
        },
        "outputs": [
          "{projectRoot}/storybook-static"
        ]
      },
      "test-a11y": {
        "command": "vitest run -c vitest.storybook.config.mts",
        "options": {
          "cwd": "{projectRoot}"
        },
        "cache": true,
        "inputs": [
          "default",
          "^default",
          "{workspaceRoot}/vitest.shared.mts"
        ]
      }
    }
  },
  "peerDependencies": {
    "@entifix/i18n": "workspace:*",
    "effect": "^4.0.7",
    "i18next": ">=26 <27",
    "react": ">=19 <20",
    "react-i18next": ">=17 <18"
  },
  "peerDependenciesMeta": {
    "@entifix/i18n": {
      "optional": true
    },
    "i18next": {
      "optional": true
    },
    "react-i18next": {
      "optional": true
    }
  }
}
