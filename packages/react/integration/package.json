{
  "name": "@entifix/react-integration",
  "nx": {
    "tags": [
      "layer:entifix",
      "scope:shared",
      "entifix:react",
      "tier:3"
    ],
    "sourceRoot": "packages/react/integration/src",
    "targets": {
      "build": {
        "executor": "@nx/js:swc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "packages/react/integration/dist",
          "main": "packages/react/integration/src/index.ts",
          "tsConfig": "packages/react/integration/tsconfig.lib.json",
          "skipTypeCheck": true,
          "stripLeadingPaths": true
        }
      }
    }
  },
  "version": "0.1.1",
  "description": "React hooks that bind entities to data: TanStack Query and Form over the entity adapters, drafts, mutations and live invalidation.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/r10c-technologies/entifix.git",
    "directory": "packages/react/integration"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@entifix/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo",
    "LICENSE"
  ],
  "dependencies": {
    "@entifix/transactions": "workspace:*",
    "@entifix/business": "workspace:*",
    "@entifix/core": "workspace:*"
  },
  "devDependencies": {
    "@entifix/testing-unit": "workspace:*",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "^5.101.4",
    "effect": "3.22.1",
    "react": "19.2.8"
  },
  "peerDependencies": {
    "@tanstack/react-form": ">=1.33 <2",
    "@tanstack/react-query": ">=5.101 <6",
    "effect": ">=3.22 <4",
    "react": ">=19 <20"
  }
}
