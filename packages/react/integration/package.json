{
  "name": "@entifix/react-integration",
  "nx": {
    "tags": [
      "tier:3"
    ],
    "sourceRoot": "packages/react/integration/src",
    "targets": {
      "build": {
        "executor": "@nx/js:swc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "packages/react/integration/dist",
          "main": "packages/react/integration/src/index.ts",
          "tsConfig": "packages/react/integration/tsconfig.lib.json",
          "skipTypeCheck": true,
          "stripLeadingPaths": true
        }
      }
    }
  },
  "version": "0.7.2",
  "description": "React hooks that bind entities to data: TanStack Query and Form over the entity adapters, drafts, mutations and live invalidation.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/r10c-technologies/entifix.git",
    "directory": "packages/react/integration"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@entifix/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./url": {
      "@entifix/source": "./src/url.ts",
      "types": "./dist/url.d.ts",
      "import": "./dist/url.js",
      "default": "./dist/url.js"
    },
    "./url-query": {
      "@entifix/source": "./src/url-query.ts",
      "types": "./dist/url-query.d.ts",
      "import": "./dist/url-query.js",
      "default": "./dist/url-query.js"
    },
    "./event-source": {
      "@entifix/source": "./src/event-source.ts",
      "types": "./dist/event-source.d.ts",
      "import": "./dist/event-source.js",
      "default": "./dist/event-source.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo",
    "LICENSE"
  ],
  "dependencies": {
    "@entifix/business": "workspace:*",
    "@entifix/core": "workspace:*",
    "@entifix/transactions": "workspace:*"
  },
  "devDependencies": {
    "@entifix/testing-unit": "workspace:*",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "^5.104.5",
    "effect": "4.0.5",
    "react": "19.3.1"
  },
  "peerDependencies": {
    "@tanstack/react-form": ">=1.33 <2",
    "@tanstack/react-query": ">=5.101 <6",
    "effect": "^4.0.5",
    "react": ">=19 <20"
  }
}
