{
  "name": "@entifix/docs-check",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@entifix/source": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "nx": {
    "tags": [
      "type:testing"
    ],
    "sourceRoot": "tools/docs/src",
    "targets": {
      "test": {
        "executor": "nx:run-commands",
        "outputs": [
          "{projectRoot}/test-output/vitest"
        ],
        "options": {
          "command": "vitest run --config vitest.config.mts",
          "cwd": "tools/docs"
        }
      }
    }
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "axe-core": "4.14.0",
    "yaml": "2.9.1"
  }
}
