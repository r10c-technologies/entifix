{
  "name": "@entifix/dev-sync",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@entifix/source": "./src/sync.ts",
      "default": "./src/sync.ts"
    }
  },
  "nx": {
    "tags": [
      "type:testing"
    ],
    "sourceRoot": "tools/dev/src",
    "targets": {
      "test": {
        "executor": "nx:run-commands",
        "outputs": [
          "{projectRoot}/test-output/vitest"
        ],
        "options": {
          "command": "vitest run --config vitest.config.mts",
          "cwd": "tools/dev"
        }
      }
    }
  },
  "devDependencies": {}
}
